# Copy to .env.production on the VPS and keep chmod 600.
# Do not commit the real .env.production file.

# Required only when bootstrapping a brand-new empty production database.
# Leave unset after the admin account exists.
# REHAB_DEFAULT_PASSWORD=replace_with_temporary_strong_password

REHAB_DB_PATH=/app/data/db.sqlite
REHAB_CORS_ALLOWED_ORIGINS=https://go.foudefun.ch
REHAB_TOKEN_TTL_HOURS=168
REHAB_MAX_IMAGE_UPLOAD_BYTES=5242880
REHAB_MAX_ACTIVITY_SOURCE_UPLOAD_BYTES=26214400
REHAB_LOGIN_LOCK_MAX_FAILURES=6
REHAB_LOGIN_LOCK_WINDOW_MINUTES=10
REHAB_LOGIN_LOCK_DURATION_MINUTES=15
# Keep disabled in production unless a temporary migration window is explicitly needed.
REHAB_ALLOW_BEARER_AUTH=false

# Optional Strava semi-automatic import.
# Configure these after creating an app at https://www.strava.com/settings/api.
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# STRAVA_REDIRECT_URI=https://go.foudefun.ch/api/strava/callback
# STRAVA_FRONTEND_REDIRECT_URL=/import?mode=strava&strava=connected
# STRAVA_DEFAULT_SCOPES=activity:read
