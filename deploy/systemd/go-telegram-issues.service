[Unit]
Description=GO Telegram to GitHub Issue Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/rehab
EnvironmentFile=/home/ubuntu/rehab/.env.telegram-bot
ExecStart=/usr/bin/env python3 /home/ubuntu/rehab/scripts/telegram_issue_bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
